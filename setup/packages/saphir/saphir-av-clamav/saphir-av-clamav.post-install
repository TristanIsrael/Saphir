#!/bin/sh

usermod -aG safecor clamav

mkdir -p /var/log/clamav
chmod 777 /var/log/clamav

mkdir -p /run/clamav
chown clamav:clamav /run/clamav
chmod 770 /run/clamav

rc-update add clamav
rc-service clamav start

rc-update add av-controller
rc-service av-controller start

# Safecor v2: the read-only guarantee now comes from the topology flag
# direct_mount: { "mode": "ro" } (the sshfs mount is read-only); the v1
# 9p repository remount is gone.

exit 0