# Contributor:
# Maintainer: Tristan Israël <tristan.israel@icloud.com>
pkgname=saphir-lib
pkgver=1.0
pkgrel=0
pkgdesc="Saphir - Library"
url="https://defense.gouv.fr/"
arch="noarch"
license="MIT"
depends="safecor-lib"
makedepends="python3-dev py3-build py3-installer"
checkdepends=""
install=""
subpackages=""
replaces=""
builddir="$srcdir/"
options="!check"  # no tests provided
py_src_dir="../../../../python"
source=""

prepare() {    
    ls -lR "../../../../"
    echo "Copy source files"
    cp -r "$py_src_dir"/libsaphir "$srcdir"
}

build() {
    cd "$srcdir/libsaphir"
    python3 -m build
}

package() {
    cd "$srcdir/lib/dist"
    python3 -m installer --destdir=$pkgdir "libsaphir-$pkgver.$pkgrel-py3-none-any.whl"
}
