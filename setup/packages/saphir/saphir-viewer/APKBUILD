# Contributor:
# Maintainer: Tristan Israël <tristan.israel@icloud.com>
pkgname=saphir-viewer
pkgver=1.0
pkgrel=1
pkgdesc="Saphir - Viewer module"
url="https://alefbet.net/"
arch="x86_64"
license="MIT"
depends="safecor-lib safecor-domu-base safecor-gui-base fontconfig freetype"
makedepends="python3-dev py3-build python3 py3-pyside6 qt6-qt5compat"
checkdepends=""
install="$pkgname.post-install"
subpackages=""
replaces=""
builddir="$srcdir/"
options="!check"  # no tests provided
py_src_dir="../../../../../python"
source="viewer.initd"

prepare() {
    echo "Copy source files"
    cp -r "$py_src_dir"/viewer "$srcdir"

    # We don't have the Alpine package for pyinstaller yet so we install it from pip
    echo "Install py3installer from PIP"    
    pip install pyinstaller --break-system-package
}

build() {    
    cd "$srcdir/viewer"    
    python3 -m PyInstaller saphir-viewer.spec --noconfirm 
}

package() {
    cd "$srcdir/viewer/dist"
    mkdir -p "$pkgdir/usr/lib/saphir"
    cp -r "$pkgname" "$pkgdir/usr/lib/saphir" 
    
    install -D -m755 "$srcdir"/viewer.initd "$pkgdir"/etc/init.d/viewer
}
sha512sums="
fbe1141389542c1fbc9628f17511c23de75375c0a96dfdf3c931f1b5de55a4d6f933bcf458a3d234e03106e86d68316d0fac529e4dc9f5c59baafc26f47314b4  viewer.initd
"
