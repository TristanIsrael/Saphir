# Contributor:
# Maintainer: Tristan Israël <tristan.israel@icloud.com>
pkgname=saphir-viewer
pkgver=1.0
pkgrel=0
pkgdesc="Saphir - Viewer module"
url="https://defense.gouv.fr/"
arch="noarch"
license="MIT"
depends="safecor-lib safecor-gui-base python3 py3-pyside6 qt6-qt5compat fontconfig freetype"
makedepends="python3-dev py3-build py3-installer"
checkdepends=""
install="$pkgname.post-install"
subpackages=""
replaces=""
builddir="$srcdir/"
options="!check"  # no tests provided
py_src_dir="../../../../../python"
source="viewer.initd"

prepare() {
    echo "Copy source files"
    cp -r "$py_src_dir"/viewer "$srcdir"
}

build() {    
    cd "$srcdir/viewer"
    python3 -m build
}

package() {
    cd "$srcdir/viewer/dist"
    mkdir -p "$pkgdir/usr/lib/saphir"
    tar xvzf "viewer-$pkgver.$pkgrel.tar.gz" -C "$pkgdir/usr/lib/saphir"    
    cd "$pkgdir/usr/lib/saphir"
    ln -s "viewer-$pkgver.$pkgrel" viewer

    install -D -m755 "$srcdir"/viewer.initd "$pkgdir"/etc/init.d/viewer
}
sha512sums="
8cb557e76ee4aad513645d86802096d8a81f62df74d89ae91b3ff6cae0804cb75817c7d1a76f4fdc224217ae18e38bc6a98ef560aa01c53220f7387f0a6a3cef  viewer.initd
"
