# Contributor:
# Maintainer: Tristan Israël <tristan.israel@icloud.com>
pkgname=saphir-gui
pkgver=3.1
pkgrel=0
pkgdesc="Saphir - Graphical User Interface"
url="https://defense.gouv.fr/"
arch="noarch"
license="MIT"
depends="safecor-lib saphir-lib safecor-gui-base python3 py3-pyside6 qt6-qt5compat py3-psutil py3-humanize py3-jinja2 weasyprint fontconfig freetype"
makedepends="python3-dev py3-build py3-installer"
checkdepends=""
install="$pkgname.post-install"
subpackages=""
replaces=""
builddir="$srcdir/"
options="!check"  # no tests provided
py_src_dir="../../../../../python"
source="gui.initd"

prepare() {
    echo "Copy source files"
    cp -r "$py_src_dir"/gui "$srcdir"
}

build() {    
    cd "$srcdir/gui"
    python3 -m build
}

package() {
    cd "$srcdir/gui/dist"
    mkdir -p "$pkgdir/usr/lib/saphir"
    tar xvzf "saphir_gui-$pkgver.$pkgrel.tar.gz" -C "$pkgdir/usr/lib/saphir"    
    cd "$pkgdir/usr/lib/saphir"
    ln -s "saphir_gui-$pkgver.$pkgrel" gui

    install -D -m755 "$srcdir"/gui.initd "$pkgdir"/etc/init.d/gui
}
sha512sums="
2183873188489869c3944929ac5cda7b1f40a55b048ed850b6cf6c32ad8e88528844264b7fa4b4d3051b206f991aa0cc9c0b72fbeb7ba77172c16c53879ee5be  gui.initd
"
