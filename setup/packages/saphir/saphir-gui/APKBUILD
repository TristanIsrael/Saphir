# Contributor:
# Maintainer: Tristan Israël <tristan.israel@icloud.com>
pkgname=saphir-gui
pkgver=3.1
pkgrel=1
pkgdesc="Saphir - Graphical User Interface"
url="https://alefbet.net/"
arch="x86_64"
license="MIT"
depends="safecor-lib saphir-lib safecor-domu-base safecor-gui-base fontconfig freetype" # py3-psutil py3-humanize py3-jinja2 weasyprint fontconfig freetype"
makedepends="python3-dev py3-build py3-installer py3-pyside6 py3-jinja2 weasyprint qt6-qt5compat"
checkdepends=""
install="$pkgname.post-install"
subpackages=""
replaces=""
builddir="$srcdir/"
options="!check"  # no tests provided
py_src_dir="../../../../../python"
source="
gui-bundle.initd
gui-folder.initd
"
bundle="yes" # if yes the package will contain a python bundle (PyInstaller) otherwise it will be packaged as a folder

prepare() {
    echo "Copy source files"
    cp -r "$py_src_dir"/gui "$srcdir"

    if [ "$bundle" = "yes" ]; then
        # We don't have the Alpine package for pyinstaller yet so we install it from pip
        echo "Install py3installer from PIP"    
        pip install pyinstaller --break-system-package
    fi
}

build() {    
    cd "$srcdir/gui"    

    if [ "$bundle" = "yes" ]; then
        python3 -m PyInstaller saphir-gui.spec --noconfirm 
    fi
}

package() {
    cd "$srcdir/gui/dist"
    mkdir -p "$pkgdir/usr/lib/saphir"    
    
    if [ "$bundle" = "yes" ]; then
        cp -r "$pkgname" "$pkgdir/usr/lib/saphir" 
        install -D -m755 "$srcdir"/gui-bundle.initd "$pkgdir"/etc/init.d/gui
    else
        cp -r "$srcdir/gui/src/Saphir/*" "$pkgdir"/usr/lib/saphir
        install -D -m755 "$srcdir"/gui-folder.initd "$pkgdir"/etc/init.d/gui
    fi
}

sha512sums="
6f21dbf85490733f0e3f28a2df1ad4f1d625000f58bf2cd5a34c05960f1a3623550cff1aa49d59f47fc9a59f4aab139eebe16ce59f571b377c58080b06696c15  gui.initd
"
