#!/bin/sh

rc-update add cgroups 
rc-service cgroups start

rc-update add av-controller
rc-service av-controller start

# Patch the container configuration to mount the local
# temporary directory
echo "lxc.mount.entry = /tmp tmp none bind,optional,create=dir,noexec,nodev,nosuid" | sudo tee -a /var/lib/lxc/saphir-container-eset/config > /dev/null
echo "lxc.mount.entry = /tmp var/tmp none bind,optional,create=dir,noexec,nodev,nosuid" | sudo tee -a /var/lib/lxc/saphir-container-eset/config > /dev/null

lxc-start -n saphir-container-eset

# Optimize cache and memory
sysctl vm.vfs_cache_pressure=200
sysctl vm.compaction_proactiveness=100
sysctl vm.min_free_kbytes=102400

exit 0